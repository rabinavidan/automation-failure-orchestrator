{
  "name": "automation-failure-orchestrator",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/ui"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test:backend && npm run test:ui",
    "test:smoke": "cd tests/backend && pytest -m smoke",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "quality": "npm run lint && npm run format:check && npm run build && npm run typecheck:tests",
    "format": "prettier --write .",
    "demo:new-regression": "tsx scripts/demo-new-regression.ts",
    "demo:known-bug": "tsx scripts/demo-known-bug.ts",
    "demo:flaky-test": "tsx scripts/demo-flaky-test.ts",
    "demo:infrastructure-failure": "tsx scripts/demo-infra-failure.ts",
    "demo:automation-failure": "tsx scripts/demo-automation-failure.ts",
    "demo:recovered-bug": "tsx scripts/demo-recovered-bug.ts",
    "demo:duplicate-delivery": "tsx scripts/demo-duplicate-delivery.ts",
    "demo:soc-brute-force": "tsx scripts/demo-soc-brute-force.ts",
    "demo:soc-malware": "tsx scripts/demo-soc-malware.ts",
    "demo:soc-triage": "tsx scripts/demo-soc-triage.ts",
    "demo:soc-response": "tsx scripts/demo-soc-response.ts",
    "demo:soc-multi-siem": "tsx scripts/demo-soc-multi-siem.ts",
    "demo:aws-local": "cd tests/backend && pytest -m system -k aws_local -v",
    "demo:observability": "cd tests/backend && pytest -m system -k observability -v",
    "demo:cleanup": "tsx scripts/demo-cleanup.ts",
    "ollama:stub": "node scripts/ollama-demo-stub.mjs",
    "shuffle:setup": "node scripts/shuffle-playbook.mjs setup",
    "shuffle:run": "cd tests/backend && pytest -m system -k shuffle -v",
    "test:python": "cd apps/enrichment-service && ruff check . && ruff format --check . && mypy && pytest -q",
    "benchmark": "npm run benchmark --workspace=apps/ingestion-service --",
    "benchmark:retrieval": "npm run benchmark:retrieval --workspace=apps/ingestion-service",
    "contracts:export": "tsx packages/shared-types/scripts/export-json-schema.ts && prettier --write contracts/json-schema --log-level warn",
    "contracts:check": "npm run contracts:export && git diff --exit-code -- contracts/json-schema",
    "test:backend": "cd tests/backend && pytest",
    "test:system": "cd tests/backend && pytest -m system",
    "test:ui": "npm test --workspace=tests/ui",
    "coverage:backend": "bash scripts/coverage-backend.sh",
    "typecheck:tests": "tsc -p tests/ui/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.0.0",
    "c8": "12.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
