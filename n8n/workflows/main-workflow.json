{
  "name": "CI Test Results Front Door",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "test-results",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "ci-webhook",
      "name": "Receive Test Results",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "webhookId": "test-results-webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ingestion-service:3001/api/runs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-webhook-secret",
              "value": "={{ $env.WEBHOOK_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body ?? $json) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "ci-ingest",
      "name": "Ingest via Orchestrator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, runId: $json.runId, duplicate: $json.duplicateRun ?? false, failures: ($json.failures ?? []).map(f => ({ testId: f.testId, fingerprint: f.fingerprint, classification: f.classification, jiraKey: f.jiraKey ?? null, awaitingApproval: Boolean(f.approval) })) }) }}",
        "options": {}
      },
      "id": "ci-respond",
      "name": "Respond to CI",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        720,
        300
      ]
    }
  ],
  "connections": {
    "Receive Test Results": {
      "main": [
        [
          {
            "node": "Ingest via Orchestrator",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ingest via Orchestrator": {
      "main": [
        [
          {
            "node": "Respond to CI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "2.0.0",
  "meta": {
    "templateCredsSetupCompleted": true,
    "instanceId": "automation-failure-orchestrator"
  },
  "id": "main-workflow",
  "tags": [
    "automation",
    "testing",
    "orchestration"
  ]
}
