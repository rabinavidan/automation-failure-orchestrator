{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "composite": true,
    "paths": {
      "@orchestrator/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@orchestrator/fingerprint-engine": ["../../packages/fingerprint-engine/src/index.ts"],
      "@orchestrator/failure-classifier": ["../../packages/failure-classifier/src/index.ts"]
    }
  },
  "references": [
    { "path": "../../packages/shared-types" },
    { "path": "../../packages/fingerprint-engine" },
    { "path": "../../packages/failure-classifier" }
  ],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
