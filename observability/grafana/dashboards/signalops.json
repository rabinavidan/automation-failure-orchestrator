{
  "uid": "signalops",
  "title": "SignalOps",
  "tags": ["signalops", "opentelemetry"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "Deterministic decisions, advisory-agent cost and service health from the ingestion service OpenTelemetry export.",
  "panels": [
    {
      "type": "row",
      "title": "Decisions",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Runs processed",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum(increase(signalops_runs_processed_total{service_name=\"signalops-ingestion\"}[$__range])))",
          "legendFormat": "runs"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Failures classified",
