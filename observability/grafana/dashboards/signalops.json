      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (signalops_classification) (increase(signalops_failures_classified_total{service_name=\"signalops-ingestion\"}[$__rate_interval]))",
          "legendFormat": "{{signalops_classification}}"
        }
