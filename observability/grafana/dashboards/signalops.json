    {
      "type": "timeseries",
      "title": "Model call latency p50 / p95 by agent node",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, signalops_agent_node) (rate(gen_ai_client_operation_duration_seconds_bucket{service_name=\"signalops-ingestion\"}[$__rate_interval])))",
          "legendFormat": "p50 {{signalops_agent_node}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, signalops_agent_node) (rate(gen_ai_client_operation_duration_seconds_bucket{service_name=\"signalops-ingestion\"}[$__rate_interval])))",
          "legendFormat": "p95 {{signalops_agent_node}}"
        }
      ],
      "id": 9
    },
