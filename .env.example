DATABASE_URL=postgresql://orchestrator:orchestrator@localhost:5432/orchestrator
N8N_WEBHOOK_URL=http://localhost:5678/webhook/test-results
N8N_ENCRYPTION_KEY=change-me-in-production
N8N_USER=admin
N8N_PASSWORD=change-me-in-production
INTEGRATION_MODE=mock
JIRA_BASE_URL=http://localhost:3002
JIRA_PROJECT_KEY=AUTO
JIRA_EMAIL=test@example.com
JIRA_API_TOKEN=mock-token
SLACK_WEBHOOK_URL=http://localhost:3002/slack/services/T00/B00/xxx
AI_ENABLED=false
MULTI_AGENT_ENABLED=true
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=30000
RAG_ENABLED=true
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OpenTelemetry export (docker-compose.observability.yml sets these for the LGTM container)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=signalops-ingestion
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
RECOVERY_PASS_THRESHOLD=3
FLAKY_HISTORY_WINDOW=5
ALERT_SUPPRESSION_WINDOW_MINUTES=60
ENRICHMENT_URL=http://localhost:3003
ENRICHMENT_TIMEOUT_MS=8000
SOC_ACTIONS_BASE_URL=http://localhost:3002
SOC_PROTECTED_HOSTS=dc-01,dc-02
# AWS: INVESTIGATION_QUEUE=sqs + INVESTIGATION_QUEUE_URL, DB_SSL=require + DB_SSL_CA_FILE
INVESTIGATION_QUEUE=in_process
# Python enrichment service (apps/enrichment-service)
ENRICHMENT_MODE=mock
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
IPINFO_TOKEN=
ENRICHMENT_PROVIDER_TIMEOUT_SECONDS=5
ENRICHMENT_CACHE_TTL_SECONDS=3600
WEBHOOK_SECRET=local-dev-secret
PORT=3001
MOCK_PORT=3002
# MCP evidence tools (M4): EVIDENCE_TRANSPORT=mcp routes agent evidence tools over MCP.
# MCP_SCOPE_SECRET (>=16 chars) signs per-investigation scope tokens; unset = /mcp disabled.
EVIDENCE_TRANSPORT=direct
MCP_SCOPE_SECRET=
# MCP_EVIDENCE_URL=http://localhost:3001/mcp
# Reviewer identities for approvals (M5): name:role1+role2:token;... roles: ci_reviewer, soc_responder, admin.
# Unset = approval endpoints disabled (503). These demo tokens are for local use only.
REVIEWER_TOKENS="demo-soc-responder:soc_responder:demo-soc-responder-token-0001;demo-ci-reviewer:ci_reviewer:demo-ci-reviewer-token-00001;demo-admin:admin:demo-admin-token-0000000001"
