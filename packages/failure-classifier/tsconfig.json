{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "composite": true,
    "paths": {
      "@orchestrator/shared-types": ["../shared-types/src/index.ts"],
      "@orchestrator/fingerprint-engine": ["../fingerprint-engine/src/index.ts"]
    }
  },
  "references": [{ "path": "../shared-types" }, { "path": "../fingerprint-engine" }],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
