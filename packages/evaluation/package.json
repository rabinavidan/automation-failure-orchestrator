{
  "name": "@orchestrator/evaluation",
  "version": "1.0.0",
  "private": true,
  "description": "Offline evaluation tooling: the labeled benchmark, retrieval benchmark, failure-mode sampler and version comparison. Never part of the service image.",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "benchmark": "tsx src/cli/benchmark.ts",
    "benchmark:retrieval": "tsx src/cli/benchmark-retrieval.ts",
    "sample:failure-modes": "tsx src/cli/sample-failure-modes.ts",
    "compare:versions": "tsx src/cli/compare-versions.ts"
  },
  "dependencies": {
    "@orchestrator/failure-classifier": "*",
    "@orchestrator/fingerprint-engine": "*",
    "@orchestrator/ingestion-service": "*",
    "@orchestrator/shared-types": "*",
    "ollama": "^0.6.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
